---
import type { CollectionEntry } from 'astro:content';
import * as simpleIcons from 'simple-icons';
import WindowsIcon from './icons/WindowsIcon.astro';
import DollarIcon from './icons/DollarIcon.astro';
import DollarCrossedIcon from './icons/DollarCrossedIcon.astro';

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { data } = game;

// Map platform names to simple-icons (with si prefix)
const platformIconMap: Record<string, keyof typeof simpleIcons | 'windows'> = {
  'Windows': 'windows', // Custom icon
  'Linux': 'siLinux',
  'macOS': 'siApple',
  'Android': 'siAndroid',
  'iOS': 'siApple',
  'Web': 'siHtml5',
  'PlayStation 4': 'siPlaystation',
};

function getPlatformIcon(platform: string) {
  const iconKey = platformIconMap[platform];
  if (iconKey === 'windows') {
    return null; // Handle separately
  }
  if (iconKey && simpleIcons[iconKey as keyof typeof simpleIcons]) {
    return simpleIcons[iconKey as keyof typeof simpleIcons];
  }
  return null;
}
---

<div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden flex flex-col h-full border border-slate-200">
  <div class="p-5 flex-grow">
    <div class="mb-2 flex items-center justify-between gap-2 flex-wrap">
      <span class="text-xs font-semibold px-2 py-1 rounded bg-indigo-100 text-indigo-800 uppercase tracking-wide">
        {data.category}
      </span>
      <div class="flex items-center gap-2 flex-wrap">
        {data.genres.map(genre => (
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-800">
            {genre}
          </span>
        ))}
      </div>
    </div>
    
    <h3 class="text-xl font-bold text-slate-900 mb-1 leading-tight">
      <a href={data.url} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 hover:underline">
        {data.title}
      </a>
    </h3>
    
    {data.year > 0 && <p class="text-xs text-slate-500 mb-3">{data.year}</p>}
    
    <p class="text-slate-600 text-sm mb-4 line-clamp-3">
      {data.description}
    </p>
  </div>
  
  <div class="bg-slate-50 px-5 py-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
    <div class="flex gap-3 items-center flex-wrap">
        {data.platforms.map(platform => {
          const icon = getPlatformIcon(platform);
          const isWindows = platform === 'Windows';
          return (
            <span class="inline-flex items-center gap-1" title={platform}>
              {isWindows ? (
                <WindowsIcon />
              ) : icon ? (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img" aria-label={icon.title}>
                  <path d={icon.path} />
                </svg>
              ) : (
                <span class="text-xs">{platform}</span>
              )}
              <span class="sr-only">{platform}</span>
            </span>
          );
        })}
    </div>
    
    <div class="flex items-center gap-2">
      {data.pricing.map(p => (
        <span class="inline-flex items-center" title={p === 'free' ? 'Free' : 'Paid'}>
          {p === 'free' ? (
            <DollarCrossedIcon />
          ) : (
            <DollarIcon />
          )}
          <span class="sr-only">{p}</span>
        </span>
      ))}
      {data.repo_url && (
        <a href={data.repo_url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 hover:text-slate-800">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" role="img" aria-label={simpleIcons.siGithub.title}>
            <path d={simpleIcons.siGithub.path} />
          </svg>
          <span class="sr-only">Code</span>
        </a>
      )}
    </div>
  </div>
</div>
